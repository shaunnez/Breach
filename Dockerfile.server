# Single-service image: authoritative Colyseus game server + the built web client (same origin).
# Railway: service "game-server" (one replica; see docs/DEPLOYMENT.md).
FROM node:22-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
COPY apps/client/package.json apps/client/
COPY packages/gameplay-tests/package.json packages/gameplay-tests/
RUN pnpm install --frozen-lockfile
COPY . .
# Empty VITE_SERVER_URL => the client talks to the origin it was served from.
ARG VITE_SERVER_URL=""
ENV VITE_SERVER_URL=$VITE_SERVER_URL
RUN pnpm --filter @breach/server build && pnpm --filter @breach/client build
RUN pnpm --filter @breach/server deploy --legacy --prod /out

FROM node:22-slim
ENV NODE_ENV=production HOST=0.0.0.0 STATIC_DIR=/app/client
ARG BUILD_SHA=dev
ENV BUILD_SHA=$BUILD_SHA
WORKDIR /app
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /out/package.json ./package.json
COPY --from=build /repo/apps/server/dist ./dist
COPY --from=build /repo/apps/client/dist ./client
EXPOSE 2567
HEALTHCHECK --interval=30s --timeout=3s CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||2567)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/index.js"]
