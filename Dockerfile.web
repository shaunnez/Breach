# Optional two-service topology (bible section 4): static client only. Set VITE_SERVER_URL to the game-server's wss:// URL.
FROM node:22-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=true
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/server/package.json apps/server/
COPY apps/client/package.json apps/client/
COPY packages/gameplay-tests/package.json packages/gameplay-tests/
RUN pnpm install --frozen-lockfile
COPY . .
ARG VITE_SERVER_URL
ENV VITE_SERVER_URL=$VITE_SERVER_URL
RUN pnpm --filter @breach/client build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/templates/default.conf.template
COPY --from=build /repo/apps/client/dist /usr/share/nginx/html
ENV PORT=8080
EXPOSE 8080
